# ==========================================
# 1. 固件、镜像与烧录工具 (重点防大文件泄露/上传)
# ==========================================
rk3576_setup/
*.img
*.img.zip
*.iso
*.tar.gz
*.tar
*.7z
*.zip
*.bin

# ==========================================
# 2. 深度学习模型资产与大权重
# ==========================================
# 忽略 PyTorch 权重与导出的 ONNX 模型 (大于 10MB)
*.pt
*.pth
*.onnx

# 关键：RKNN 转换过程中生成的临时调试优化图
check*.onnx

# 保留或忽略编译出的板端 rknn 模型
# (rknn 文件仅 3~5MB，若想跟踪可保留；若不想提交模型二进制则取消下行注释)
# *.rknn

# ==========================================
# 3. 本地 Python 虚拟环境与解释器
# ==========================================
miniconda3/
conda_envs/
conda_pkgs/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 4. 数据集、校准图与标定缓存
# ==========================================
dataset/
calibration_data/
*.jpg
*.jpeg
*.png
*.bmp
*.mp4
*.avi
# 保留可能需要的路径文本索引 (可选)
!dataset.txt

# ==========================================
# 5. IDE、编辑器配置与操作系统临时文件
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================
# 6. 构建产物与测试日志
# ==========================================
build/
dist/
*.egg-info/
*.log
